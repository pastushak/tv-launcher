<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">@color/coral</item>
    </style>

    <!-- Темні теплі діалоги з кораловим акцентом -->
    <style name="LauncherDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:colorControlActivated">@color/coral</item>
        <item name="android:colorControlHighlight">#33F5F1EA</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">#B3F5F1EA</item>
        <item name="android:textColorAlertDialogListItem">@color/cream</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
